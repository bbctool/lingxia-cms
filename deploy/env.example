# /root/lingxia/.env.db — docker compose --env-file
POSTGRES_PASSWORD=change-me-postgres-password

# /root/lingxia/lingxia-cms/.env
DATABASE_URI=postgres://payload:change-me-postgres-password@127.0.0.1:5433/lingxia_cms
DATABASE_URL=postgres://payload:change-me-postgres-password@127.0.0.1:5433/lingxia_cms
PAYLOAD_SECRET=change-me-min-32-chars-long-secret-key
PORT=9001
# Must match the browser Origin (scheme + host + port). After assigning a domain, set this to the HTTPS URL.
PAYLOAD_PUBLIC_URL=https://vm-0-10-ubuntu.takaya-justitia.ts.net
HOME_URL=http://39.102.52.74:9000
# Extra CSRF/CORS origins (comma-separated full URLs)
# PAYLOAD_CSRF_ORIGINS=http://62.234.3.131:9001,http://localhost:9001
# Bare hostnames only — auto adds https:// and http:// (Tailscale / reverse proxy)
# PAYLOAD_CSRF_HOSTS=vm-0-10-ubuntu.takaya-justitia.ts.net
REVALIDATE_URL=http://127.0.0.1:9000/api/revalidate
REVALIDATE_SECRET=change-me-revalidate-secret
PREVIEW_SECRET=change-me-preview-secret

# /root/lingxia/lingxia_home/.env
PORT=9000
NEXT_PUBLIC_SITE_URL=http://39.102.52.74:9000
SITE_URL=http://39.102.52.74:9000
CONTENT_API_URL=http://127.0.0.1:9001
CONTENT_SITE_SLUG=lingxia
CONTENT_SITE_ID=1
CONTENT_API_KEY=
