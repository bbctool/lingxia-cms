{
  "name": "lingxia-cms",
  "version": "1.0.0",
  "private": true,
  "description": "Lingxia content service (Payload 3 + PostgreSQL)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "ci": "cross-env NODE_OPTIONS=--no-deprecation payload migrate && npm run build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev -p 3001",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx src/seed/index.ts",
    "seed:faq": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/seed-faq.ts",
    "seed:push": "cross-env NODE_OPTIONS=--no-deprecation PAYLOAD_DB_PUSH=true tsx src/seed/index.ts",
    "generate:faq": "tsx scripts/generate-faq-artifacts.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start -p ${PORT:-3001}"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.82.1",
    "@payloadcms/next": "3.82.1",
    "@payloadcms/richtext-lexical": "3.82.1",
    "@payloadcms/ui": "3.82.1",
    "cross-env": "10.1.0",
    "graphql": "^16.8.1",
    "next": "15.3.9",
    "payload": "3.82.1",
    "react": "19.0.1",
    "react-dom": "19.0.1",
    "sharp": "0.34.2"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "19.0.1",
    "@types/react-dom": "19.0.1",
    "eslint": "^9.16.0",
    "gray-matter": "^4.0.3",
    "tsx": "4.21.0",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
